{
	"name": "spring-office",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"dev:preview": "bun run build && bunx --bun vite preview",
		"dev:emails": "email dev --dir src/lib/server/email",
		"env:pull": "railway variables -e dev -s vars -k > .env",
		"docker:start": "docker compose up -d",
		"docker:stop": "docker compose stop",
		"db:push": "drizzle-kit push",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "db/seed/index.ts",
		"build": "bunx --bun vite build",
		"start": "bun run ./build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.1",
		"@react-email/preview-server": "5.0.1",
		"@sveltejs/kit": "2.48.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "^1.3.2",
		"@types/node": "^24.10.0",
		"@types/react": "^19.2.2",
		"drizzle-kit": "^0.31.6",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "0.7.1",
		"react-email": "^5.0.1",
		"svelte": "^5.43.5",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.3",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/sn-pro": "^5.2.5",
		"@opensky/remotes": "^0.0.3",
		"@opensky/seo": "^1.1.0",
		"@opensky/style": "^0.1.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@react-email/components": "^1.0.0",
		"@simplewebauthn/browser": "^13.2.2",
		"@simplewebauthn/server": "^13.2.2",
		"@tabler/icons-svelte": "^3.35.0",
		"bits-ui": "^2.14.2",
		"croner": "^9.1.0",
		"drizzle-orm": "^0.44.7",
		"fluid-dnd": "^2.6.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"resend": "^6.4.2",
		"runed": "^0.35.1",
		"ua-parser-js": "^2.0.6"
	}
}
