{
	"name": "spring-office",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:emails": "email dev --dir src/lib/server/email",
		"dev:up": "docker compose up -d db && vite dev",
		"env:pull": "railway variables -e dev -s vars -k > .env",
		"db:start": "docker compose up -d db",
		"db:logs": "docker compose logs -f db",
		"db:stop": "docker compose stop",
		"db:push": "drizzle-kit push",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:reset": "bun run db/reset.ts",
		"db:seed": "bun run db/seed/index.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"build": "vite build",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@react-email/preview-server": "4.3.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "2.48.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.16",
		"@types/node": "^24.9.1",
		"@types/react": "^19.2.2",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.5",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "0.7.1",
		"react-email": "^4.3.2",
		"svelte": "^5.42.3",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.16",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vite": "^7.1.12"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/sn-pro": "^5.2.5",
		"@node-rs/argon2": "^2.0.2",
		"@opensky/remotes": "^0.0.3",
		"@opensky/seo": "^1.1.0",
		"@opensky/style": "^0.1.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@react-email/components": "^0.5.7",
		"@simplewebauthn/browser": "^13.2.2",
		"@simplewebauthn/server": "^13.2.2",
		"@tabler/icons-svelte": "^3.35.0",
		"@upstash/ratelimit": "^2.0.6",
		"@upstash/redis": "^1.35.6",
		"bits-ui": "^2.14.1",
		"drizzle-orm": "^0.44.7",
		"fluid-dnd": "^2.6.2",
		"postgres": "^3.4.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"resend": "^6.3.0",
		"runed": "^0.35.1"
	}
}
