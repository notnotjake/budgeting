{
	"name": "spring-office",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"dev:preview": "bun run build && bunx --bun vite preview",
		"dev:emails": "email dev --dir src/lib/server/email",
		"env:pull": "railway environment dev && railway variables -e dev -s vars -k > .env",
		"docker:start": "docker compose up -d",
		"docker:stop": "docker compose stop",
		"db:push": "drizzle-kit push",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "db/seed/index.ts",
		"build": "bunx --bun vite build",
		"start": "bun run ./build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prettier": "prettier --write .",
		"eslint": "eslint . --cache --concurrency auto"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.2",
		"@react-email/preview-server": "^5.1.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.5",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"react-email": "^5.1.0",
		"svelte": "^5.46.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.0",
		"vite": "^7.3.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/sn-pro": "^5.2.5",
		"@opensky/remotes": "^0.0.3",
		"@opensky/seo": "^1.1.0",
		"@opensky/style": "^0.1.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@react-email/components": "^1.0.2",
		"@simplewebauthn/browser": "^13.2.2",
		"@simplewebauthn/server": "^13.2.2",
		"@tabler/icons-svelte": "^3.36.0",
		"@upstash/ratelimit": "2.0.7",
		"autumn-js": "^0.1.60",
		"bits-ui": "^2.14.4",
		"croner": "^9.1.0",
		"drizzle-orm": "^0.45.1",
		"fluid-dnd": "^2.6.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"resend": "^6.6.0",
		"runed": "^0.37.0",
		"svelte-easy-crop": "^5.0.0",
		"ua-parser-js": "^2.0.7"
	}
}
