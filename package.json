{
	"name": "spring-office",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"env:pull": "railway variables -e dev -s vars -k > .env",
		"db:start": "docker compose up -d db",
		"db:logs": "docker compose logs -f db",
		"db:stop": "docker compose stop",
		"db:push": "drizzle-kit push",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:reset": "bun run db/reset.ts",
		"db:seed": "bun run db/seed/index.ts",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22",
		"@types/react": "^19.1.12",
		"drizzle-kit": "^0.30.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"react-email": "^4.2.8",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.6",
		"@opensky/seo": "^1.1.0",
		"@opensky/style": "^0.1.0",
		"@tabler/icons-svelte": "^3.34.1",
		"bits-ui": "^2.9.4",
		"drizzle-orm": "^0.40.0",
		"postgres": "^3.4.5",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"resend": "^6.0.2"
	}
}
